{
  "entities": {
    "ContactMessage": {
      "title": "Contact Message",
      "description": "A message submitted through the contact form.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Sender name" },
        "email": { "type": "string", "description": "Sender email" },
        "subject": { "type": "string", "description": "Message subject" },
        "message": { "type": "string", "description": "Message body" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["name", "email", "subject", "message", "createdAt"]
    },
    "NewsletterSubscription": {
      "title": "Newsletter Subscription",
      "description": "An email address subscribed to the newsletter.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "contactMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Stores contact messages"
    },
    "newsletterSubscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/NewsletterSubscription" },
      "description": "Stores newsletter subscriptions"
    }
  }
}
